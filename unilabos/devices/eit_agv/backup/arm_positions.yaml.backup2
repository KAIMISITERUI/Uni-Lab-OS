# 夹爪类型定义 (2种夹爪, 适配不同托盘)
grippers:
  gripper_type_a:
    slot: 1                    # 快换料位编号(bg1, 对应DI3)
    description: "A型托盘夹爪"
  gripper_type_b:
    slot: 2                    # 快换料位编号(bg2, 对应DI4)
    description: "B型托盘夹爪"

# 夹爪存放位置 (用于自动换爪, 需要实际标定坐标)
gripper_storage:
  gripper_type_a:
    pose: [-600.0, 400.0, 200.0, -3.14159, 0.0, 0.0]  # TODO: 需要实际标定
    descend_z: -50             # 对接下探距离, 单位mm
    lift_z: 30                 # 脱离提升距离, 单位mm
    speed: 0.6
    acceleration: 0.3
    description: "A型夹爪存放位置"
  gripper_type_b:
    pose: [-500.0, 400.0, 200.0, -3.14159, 0.0, 0.0]  # TODO: 需要实际标定
    descend_z: -50
    lift_z: 30
    speed: 0.6
