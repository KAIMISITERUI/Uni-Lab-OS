    descend_z: -144  # 下探距离, 沿工具坐标系Z轴, 负值表示下降, 单位mm
    lift_z: 50  # 提升距离, 沿工具坐标系Z轴, 正值表示上升, 单位mm
    speed: 0.6  # 运动速度百分比 (0-1)
