# 机械臂工位坐标配置文件
# 位姿格式: [x, y, z, rx, ry, rz], 位置单位mm, 姿态单位rad
# 所使用的所有距离单位均为mm，角度均为rad

# 托盘抓取/放置位置
tray_position:
  # 托盘1抓取/放置位置
  agv_tray_1:
    pose: [-680.82439, 438.59979, 191.24405, -3.14153742, -1.43e-06, -0.05532694]  # 过渡点位姿 (托盘上方的安全位置), 位置单位mm, 姿态单位rad
    descend_z: -144  # 下探距离, 沿工具坐标系Z轴, 负值表示下降, 单位mm
    lift_z: 20  # 提升距离, 沿工具坐标系Z轴, 正值表示上升, 单位mm
    speed: 0.2  # 运动速度百分比 (0-1)
    acceleration: 0.1  # 加速度百分比 (0-1)
    description: "AGV托盘1抓取/放置位置"

