{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "vue": ["../../../eit_chemical_manager/web/frontend/node_modules/vue"],
      "vue-router": ["../../../eit_chemical_manager/web/frontend/node_modules/vue-router"],
      "axios": ["../../../eit_chemical_manager/web/frontend/node_modules/axios"],
      "element-plus": ["../../../eit_chemical_manager/web/frontend/node_modules/element-plus"],
      "element-plus/*": ["../../../eit_chemical_manager/web/frontend/node_modules/element-plus/*"],
      "@element-plus/icons-vue": [
        "../../../eit_chemical_manager/web/frontend/node_modules/@element-plus/icons-vue"
      ]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.vue"]
}

